[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
Actions=xoraWhere;xoraSend;xoraVersions;
X-KDE-Priority=TopLevel

[Desktop Action xoraSend]
Name=Send to a device
Icon=network-workgroup
Exec=xora fabric send %F

[Desktop Action xoraVersions]
Name=Versions (Timeline)
Icon=document-open-recent
Exec=xora center timeline --path %f

[Desktop Action xoraWhere]
Name=Where is this file?
Icon=help-about
Exec=xora where --gui %f
