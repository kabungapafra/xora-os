# XORA boot splash
Window.SetBackgroundTopColor(0.059, 0.055, 0.118);     # #0F0E1E
Window.SetBackgroundBottomColor(0.035, 0.040, 0.095);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 1);

# three dots under the logo, pulsing in turn
dot = Image.Text("●", 0.118, 0.784, 0.941);   # #1EC8F0
for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot);
  dots[i].SetPosition(Window.GetX() + Window.GetWidth() / 2 - 30 + i * 24, logo.y + logo.image.GetHeight() + 50, 2);
}
t = 0;
fun refresh() {
  t++;
  pulse = Math.Sin(t / 25) * 0.15 + 0.85;
  logo.sprite.SetOpacity(pulse);
  for (i = 0; i < 3; i++) {
    phase = Math.Sin((t - i * 12) / 10);
    if (phase < 0) phase = 0;
    dots[i].SetOpacity(0.25 + phase * 0.75);
  }
}
Plymouth.SetRefreshFunction(refresh);

# password prompt (disk encryption)
fun display_password(prompt, bullets) {
  global.pw = Image.Text(prompt + "  " + String("••••••••••••••••••••").SubString(0, bullets), 0.9, 0.92, 0.96);
  global.pws = Sprite(global.pw);
  global.pws.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.pw.GetWidth() / 2, logo.y + logo.image.GetHeight() + 90, 3);
}
fun display_normal() { if (global.pws) global.pws.SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);

fun message(text) {
  global.msg = Image.Text(text, 0.54, 0.55, 0.67);
  global.msgs = Sprite(global.msg);
  global.msgs.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.msg.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 3);
}
Plymouth.SetMessageFunction(message);
