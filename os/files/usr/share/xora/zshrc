# XORA system-wide zsh configuration (sourced from ~/.zshrc). Updates with the OS: edit ~/.zshrc instead.
# ~/.zshrc — XORA OS (Kali-style prompt + XORA features)

setopt autocd interactivecomments magicequalsubst nonomatch notify numericglobsort promptsubst
WORDCHARS=${WORDCHARS//\/}
PROMPT_EOL_MARK=""

# ---- keys
bindkey -e
bindkey ' ' magic-space
bindkey '^U' backward-kill-line
bindkey '^[[3;5~' kill-word
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line

# ---- completion
autoload -Uz compinit
compinit -d ~/.cache/zcompdump
zstyle ':completion:*:*:*:*:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' rehash true

# ---- history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=20000
setopt hist_expire_dups_first hist_ignore_dups hist_ignore_space hist_verify share_history
alias history="history 0"

# ---- XORA: which Space am I in? (recomputed only when the folder changes)
typeset -g XORA_SPACE=""
_xora_find_space() {
  XORA_SPACE=""
  local f d best=""
  for f in ~/.config/xora/spaces/*.yaml(N); do
    d=$(sed -n 's/^dir: *//p' "$f" | head -1)
    d=${d/#\~/$HOME}
    [[ -z $d ]] && d="$HOME/Spaces/${f:t:r}"
    if [[ $PWD == $d || $PWD == $d/* ]] && (( ${#d} > ${#best} )); then
      best=$d; XORA_SPACE=${f:t:r}
    fi
  done
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _xora_find_space
_xora_find_space

_xora_git() {
  local b
  b=$(git symbolic-ref --short HEAD 2>/dev/null) || return
  print -n " %F{8}git:%F{green}${b}%f"
}
_xora_space() { [[ -n $XORA_SPACE ]] && print -n "%F{%(#.blue.green)}─[%F{cyan}${XORA_SPACE}%F{%(#.blue.green)}]%f"; }

# ---- prompt: Ubuntu style by default (pafra@xora:~/Projects$), the Kali two-line style with XORA_PROMPT=kali
_xora_space_short() { [[ -n $XORA_SPACE ]] && print -n " %F{cyan}[${XORA_SPACE}]%f"; }
if [[ ${XORA_PROMPT:-ubuntu} == kali ]]; then
  # Kali two-line prompt. Root: blue frame, red user, '#'
  PROMPT=$'%F{%(#.blue.green)}┌──(%B%F{%(#.red.blue)}%n㉿%m%b%F{%(#.blue.green)})-[%B%F{reset}%(6~.%-1~/…/%4~.%5~)%b%F{%(#.blue.green)}]$(_xora_space)%(?..%F{%(#.blue.green)}─[%F{red}%?%F{%(#.blue.green)}])$(_xora_git)\n%F{%(#.blue.green)}└─%B%(#.%F{red}#.%F{blue}$)%b%F{reset} '
else
  # Ubuntu: bold green user@host, bold blue folder; the Space and Git branch after it; red exit code if it failed
  PROMPT='%B%F{%(#.red.green)}%n@%m%f%b:%B%F{blue}%~%f%b$(_xora_space_short)$(_xora_git)%(?.. %F{red}[%?]%f)%(#.#.$) '
fi
RPROMPT=''

# new line between commands, like Kali
_xora_newline() { [[ ${XORA_PROMPT:-ubuntu} == kali && -n $_xora_first ]] && print ""; _xora_first=1; }
add-zsh-hook precmd _xora_newline

# ---- XORA: F2 runs the fix XORA just suggested
_xora_fix_widget() {
  local f=${XDG_STATE_HOME:-$HOME/.local/state}/xora/fix
  if [[ -s $f ]]; then
    BUFFER=$(<$f)
    CURSOR=${#BUFFER}
    zle accept-line
  else
    zle -M "xora: no fix suggested"
  fi
}
zle -N _xora_fix_widget
bindkey '^[OQ' _xora_fix_widget     # F2
bindkey '^[[12~' _xora_fix_widget   # F2 (some terminals)

# ---- XORA: when a command fails, offer to explain it (F2). Never automatic: F2 re-runs the command
#      under `xora explain`, so commands that aren't safe to repeat are left alone.
_xora_preexec() { _xora_last=$1; }
_xora_failed() {
  local st=$?
  local cmd=$_xora_last; _xora_last=
  [[ -z $cmd || $st -eq 0 || $st -eq 127 || $st -ge 128 ]] && return     # ok, not found (handled), Ctrl-C/signals
  (( $+commands[xora] )) || return
  local -a words; words=(${(z)cmd}); local w=$words[1]
  case $w in
    rm|sudo|su|ssh|scp|rsync|dd|mkfs*|shutdown|reboot|xora|on|undo|explain|git|kubectl|helm|tofu|terraform|ansible*|docker|podman|vim|vi|nano|less|man|top|htop|exit) return ;;
  esac
  local f=${XDG_STATE_HOME:-$HOME/.local/state}/xora/fix
  [[ -s $f && $f -nt ${XDG_STATE_HOME:-$HOME/.local/state}/xora/.cmdstart ]] && return    # explain already suggested a fix
  mkdir -p ${f:h} && print -r -- "xora explain -- $cmd" > $f
  print -P "%F{8}[xora] that failed (exit $st) · %F{cyan}F2%F{8} runs it again and explains why%f"
}
_xora_mark_start() { mkdir -p ${XDG_STATE_HOME:-$HOME/.local/state}/xora && : > ${XDG_STATE_HOME:-$HOME/.local/state}/xora/.cmdstart; }
add-zsh-hook preexec _xora_preexec
add-zsh-hook preexec _xora_mark_start
precmd_functions=(_xora_failed ${precmd_functions:#_xora_failed})   # first: it needs the exit status

# ---- XORA: run any command on another device:  on office-pc flutter build apk  ·  on auto make -j16
on() {
  if (( $# < 2 )); then print "usage: on <device|auto> <command…>   (devices: xora fabric ls)"; return 2; fi
  local dev=$1; shift
  xora fabric run --on "$dev" -- "$@"
}

# ---- XORA: a line starting with '# ' is a question in plain words
_xora_accept_line() {
  if [[ $BUFFER == '# '* || $BUFFER == '#'[[:alpha:]]* ]]; then
    local q=${BUFFER#\#}
    BUFFER="xora ask ${(q)q# }"
  fi
  zle .accept-line
}
zle -N accept-line _xora_accept_line

# ---- XORA: unknown command → say what to install
command_not_found_handler() {
  print -P "%F{red}zsh: command not found: $1%f" >&2
  if (( $+commands[xora] )); then
    xora explain -- sh -c "echo '$1: command not found' >&2; exit 127" 2>/dev/null | grep 'xora explain'
  fi
  return 127
}

# ---- XORA: deleting saves a Timeline snapshot first (use \rm or /bin/rm to skip)
alias rm='xora rm'
alias undo='xora undo'
alias explain='xora explain --'
alias space='xora space'

# ---- colours and aliases (Kali defaults)
if [[ -x /usr/bin/dircolors ]]; then
  eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
  alias diff='diff --color=auto'
  alias ip='ip --color=auto'
fi
alias ll='ls -l'
alias la='ls -A'
alias l='ls -CF'

# ---- plugins (installed in the image)
[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh && ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#666666'
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

