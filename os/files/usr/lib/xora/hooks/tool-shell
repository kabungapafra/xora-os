#!/bin/bash
# Opened from the app grid: show what a terminal tool does, then leave a ready shell.
tool="$1"; shift
printf '\033[1;36m%s\033[0m  %s\n\n' "$tool" "$*"
if command -v "$tool" >/dev/null 2>&1; then
  { "$tool" --help 2>&1 || "$tool" -h 2>&1; } | head -40
  printf '\n\033[2mType "%s ..." to use it · "man %s" for the full manual · "xora tools" lists every tool\033[0m\n\n' "$tool" "$tool"
else
  printf '%s is part of the full Kali toolset. Install it with:  xora tools kali\nThen run it with:            xora tools run %s\n\n' "$tool" "$tool"
fi
exec "${SHELL:-/bin/zsh}" -i
