#!/bin/bash
# Runs at login before KDE's shortcut service starts. KDE only reads each user's own shortcut file,
# so XORA's defaults are written there once. After that the user's own changes are never touched.
#   Super = Overview (windows + workspaces + search) · Super+A = app grid · Alt+F1 = classic menu · Ctrl+Alt+T = Ptyxis
set -u
marker="${XDG_STATE_HOME:-$HOME/.local/state}/xora/session-defaults-v2"
[ -e "$marker" ] && exit 0
w() { kwriteconfig6 --file kglobalshortcutsrc "$@"; }
w --group kwin --key Overview $'Meta\tMeta+W,Meta+W,Toggle Overview'
w --group plasmashell --key "activate application launcher" "Alt+F1,Alt+F1,Activate Application Launcher"
w --group services --group org.gnome.Ptyxis.desktop --key _launch "Ctrl+Alt+T"
# Super+A is the app grid (like Ubuntu); KDE also gives it to "walk through activities", which wins
w --group plasmashell --key "next activity" "none,Meta+A,Walk through activities"
w --group services --group org.kde.konsole.desktop --key _launch "none"
mkdir -p "$(dirname "$marker")" && date > "$marker"
