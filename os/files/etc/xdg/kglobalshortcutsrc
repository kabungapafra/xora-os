# XORA keyboard shortcuts, like Ubuntu
#   Super = Overview (windows + workspaces + search) · Super+A = all apps & tools · Alt+F1 = classic menu
#   Ctrl+Alt+T = terminal (Ptyxis)
[kwin]
Overview=Meta\tMeta+W,Meta+W,Toggle Overview

[plasmashell]
activate application launcher=Alt+F1,Alt+F1,Activate Application Launcher

[services][org.gnome.Ptyxis.desktop]
_launch=Ctrl+Alt+T

[services][org.kde.konsole.desktop]
_launch=none
