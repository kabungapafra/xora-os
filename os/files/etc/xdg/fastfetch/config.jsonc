// XORA: system info with the XORA logo (fastfetch would otherwise draw the base distro's logo)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/xora/fastfetch-logo.txt",
    "color": { "1": "38;2;30;212;242", "2": "38;2;10;124;240" },
    "padding": { "right": 3 }
  },
  "display": { "color": { "keys": "38;2;30;200;240" }, "separator": "  " },
  "modules": ["title", "separator", "os", "host", "kernel", "uptime", "packages", "shell", "de", "wm",
              "terminal", "cpu", "gpu", "memory", "disk", "battery", "localip", "break", "colors"]
}
